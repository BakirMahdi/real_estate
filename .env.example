POSTGRES_DB=realestate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=0000

DB_HOST=db
DB_PORT=5432
DB_NAME=realestate
DB_USER=postgres
DB_PASSWORD=0000

# Used to sign login JWTs - change this to a random string in any real deployment.
JWT_SECRET_KEY=your-secret-key-change-this-in-production

# Login session lifetime in minutes. Defaults to 30 days (43200) if unset.
# ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Fallback API key (x-api-key header) for triggering/cancelling scrapes without
# a logged-in admin session (e.g. curl, cron). Defaults to "admin123" if unset
# - change this to a random string in any real deployment. Not needed for
# normal use: an admin's login session already works for /scrape.
ADMIN_PASSWORD=admin123

# Send the auth cookie only over HTTPS. Keep false for local http://localhost
# development; set true in any real (HTTPS) deployment.
COOKIE_SECURE=false

# Comma-separated browser origins allowed to call the API with credentials.
# Same-origin traffic via the nginx /api proxy does not need this; it's only
# for a cross-origin dev server.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# SMTP for sending sign-up verification codes. If SMTP_HOST is empty, the code
# is printed to the backend logs instead of emailed (fine for local dev).
# For Gmail: host=smtp.gmail.com, port=587, user=you@gmail.com, and an
# App Password (not your normal password) as SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER if left empty.
SMTP_FROM=
# Set true only if your network intercepts TLS with a self-signed CA (some
# corporate/school proxies or antivirus) and sending fails with a certificate
# error. Skips SMTP cert verification. Keep false in production.
SMTP_SKIP_TLS_VERIFY=false

# Module 5 (conversational agent). Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the default Gemini model.
# GEMINI_MODEL=gemini-flash-lite-latest

# "Sign in with Google" OAuth Client ID (Web application) from
# https://console.cloud.google.com/apis/credentials - add http://localhost:3000
# as an authorized JavaScript origin. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=

# pgAdmin (http://localhost:5433) login. Defaults to admin@admin.com/admin if
# unset - change these if this ever runs somewhere besides localhost.
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
